GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# API service (all optional locally)
# FINANCEAI_CORS_ORIGINS=["http://localhost:3000"]
# FINANCEAI_CORS_ORIGIN_REGEX=
# FINANCEAI_DATABASE_URL=sqlite:///data/app/financeai.db
# FINANCEAI_EXPLAIN_LLM_RATE_LIMIT=10/minute
# FINANCEAI_ENABLE_PLANS=true

# Dataset bootstrap (python -m api.bootstrap). Not needed while data/raw/stock_prices.parquet
# exists locally; set both to fetch the pinned release asset instead.
# FINANCEAI_DATASET_URL=https://github.com/<owner>/FinanceAI/releases/download/dataset-v1/stock_prices.parquet
# FINANCEAI_DATASET_SHA256=48a8585cd14dcf6f7f46dbbf336ddce73d10a873c41f8a190b6fd23fbd165fc3
# FINANCEAI_DATASET_TOKEN=   # private repositories only
